{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AABrovarnik/swarm/schemas/report.schema.json",
  "title": "Swarm agent report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "agent",
    "attempt",
    "created_at",
    "status",
    "summary",
    "changes",
    "verification"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "model": {
      "type": ["string", "null"]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["completed", "partial", "blocked", "failed"]
    },
    "summary": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "verification": {
      "type": "array",
      "items": {"type": "string"}
    },
    "risks": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "next_action": {
      "type": ["string", "null"]
    },
    "approval_needed": {
      "type": "boolean",
      "default": false
    }
  }
}
